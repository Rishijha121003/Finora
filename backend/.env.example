# Finora Backend Environment Variables Example Template

PROJECT_NAME="Finora Personal Finance API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finora_db"

# Secret Key for JWT token signing (MUST be set exclusively via environment variable)
JWT_SECRET=your_secure_random_secret_here
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_DAYS=7

# Default Currency Code
DEFAULT_CURRENCY="INR"
