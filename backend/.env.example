# Finora Backend Environment Variables Template
# Copy this file to .env and replace with your actual configuration.

PROJECT_NAME="Finora Personal Finance API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL mandatory for production)
DATABASE_URL="postgresql://postgres:your_postgres_password@localhost:5432/finora_db"

# Mandatory JWT Authentication Secret (Do NOT print, log, or commit real secrets)
JWT_SECRET="your_secure_random_secret_here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_DAYS=7

# Explicit Allowed CORS Origins (Comma-separated or JSON list)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://usefinora.netlify.app"
